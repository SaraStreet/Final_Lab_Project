extends ../layout

block content
  .hero
    .hero-content
      h1 Downtown Donuts
      p Handcrafted Donuts & Coffee Since 1992
      .cta-buttons
        a.btn.btn-primary(href='/menu') Explore Our Menu
        a.btn.btn-secondary(href='/comments') See Customer Reviews

  .features
    .feature-card
      h2 🍩 Fresh Daily
      p Handcrafted donuts made fresh every morning with quality ingredients

    .feature-card
      h2 ☕ Premium Coffee
      p Locally roasted coffee beans served hot or cold

    .feature-card
      h2 👨‍👩‍👧‍👦 Family Owned
      p A local favorite for over 30 years, serving our community with pride

  .cta-section
    h2 Order Online Today
    p Fast delivery through your favorite platform
    .order-buttons
      a.btn.btn-outline(href='https://www.ubereats.com', target='_blank', rel='noopener') 
        span UberEats
      a.btn.btn-outline(href='https://www.doordash.com', target='_blank', rel='noopener') 
        span DoorDash
      a.btn.btn-outline(href='https://www.grubhub.com', target='_blank', rel='noopener') 
        span GrubHub

  .info-section
    h2 Visit Us
    .info-grid
      .info-card
        h3 📍 Location
        p 123 Main Street
        p Downtown

      .info-card
        h3 ⏰ Hours
        p Monday-Friday: 6AM - 6PM
        p Saturday-Sunday: 7AM - 4PM

      .info-card
        h3 ☎️ Contact
        p(555) 867-5309
        p hello@downtowndonuts.com
