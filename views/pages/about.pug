extends ../layout

block content
  .page-header
    h1 About Downtown Donuts
    p Our story since 1992

  .about-content
    section.about-section
      h2 Our Story
      p
        | Downtown Donuts was founded in 1992 by local entrepreneurs with a simple mission: 
        | to bring the finest donuts and coffee to our community. What started as a small corner 
        | shop has grown into a beloved neighborhood institution, serving generations of families 
        | and visitors.
      
      p
        | We believe in quality, tradition, and community. Every donut is handcrafted fresh 
        | each morning using the finest ingredients. Every cup of coffee is made with pride 
        | using locally roasted beans. Every customer is treated like family.

    section.about-section
      h2 Our Commitment
      .commitment-grid
        .commitment-card
          h3 Quality
          p We never compromise on the quality of our ingredients or our craft

        .commitment-card
          h3 Freshness
          p Everything is made fresh daily in our kitchen

        .commitment-card
          h3 Community
          p We're proud to be part of downtown and support local causes

        .commitment-card
          h3 Innovation
          p We honor tradition while embracing new flavors and ideas

    section.about-section
      h2 Why Choose Downtown Donuts?
      ul.reasons-list
        li Hand-crafted donuts made fresh every morning
        li Locally roasted premium coffee
        li Family-owned and operated for over 30 years
        li Committed to using quality, local ingredients
        li A welcoming space for our community
        li Options for dietary preferences
        li Catering available for events

    section.about-section
      h2 Visit Us Today
      .visit-card
        .visit-info
          h3 📍 Location
          p 123 Main Street
          p Downtown

        .visit-info
          h3 ⏰ Hours
          p Monday - Friday: 6AM - 6PM
          p Saturday - Sunday: 7AM - 4PM

        .visit-info
          h3 ☎️ Contact
          p (555) 867-5309
          p hello@downtowndonuts.com

    section.about-section
      h2 Order Online
      p Can't make it in? No problem! Order online through your favorite delivery service.
      .order-buttons
        a.btn.btn-outline(href='https://www.ubereats.com', target='_blank', rel='noopener') UberEats
        a.btn.btn-outline(href='https://www.doordash.com', target='_blank', rel='noopener') DoorDash
        a.btn.btn-outline(href='https://www.grubhub.com', target='_blank', rel='noopener') GrubHub

    .testimonial-section
      h2 What Our Customers Say
      .testimonial
        blockquote
          p "Best donuts in town! Been coming here for 20 years."
        cite - Sarah M.

      .testimonial
        blockquote
          p "The coffee is exceptional and the staff is always friendly."
        cite - James T.

      .testimonial
        blockquote
          p "A true community gem. This place has heart."
        cite - Maria L.
